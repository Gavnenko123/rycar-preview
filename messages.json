[{"id": "cms88wxle0001tvd8ooaxe7dm", "role": "narrator", "content": "\u041f\u0430\u043b\u0430\u0442\u043a\u0430 \u043f\u0430\u0445\u043b\u0430 \u043a\u043e\u0436\u0435\u0439, \u0434\u044b\u043c\u043e\u043c \u0438 \u0447\u0443\u0436\u0438\u043c \u043f\u043e\u0442\u043e\u043c. \u0413\u0434\u0435-\u0442\u043e \u0440\u044f\u0434\u043e\u043c \u0445\u0440\u0430\u043f\u0435\u043b\u0438 \u2014 \u0442\u044f\u0436\u0435\u043b\u043e, \u0441 \u043f\u0440\u0438\u0441\u0432\u0438\u0441\u0442\u043e\u043c.\n\n\u041d\u043e\u0442\u0442\u0430 \u043e\u0442\u043a\u0440\u044b\u043b \u0433\u043b\u0430\u0437\u0430. \u041f\u0430\u0440\u0443\u0441\u0438\u043d\u0430 \u043d\u0430\u0434 \u0433\u043e\u043b\u043e\u0432\u043e\u0439, \u0441\u0435\u0440\u044b\u0439 \u043f\u0440\u0435\u0434\u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043d\u044b\u0439 \u0441\u0432\u0435\u0442 \u0441\u043a\u0432\u043e\u0437\u044c \u0449\u0435\u043b\u044c. \u0427\u0443\u0436\u043e\u0435 \u0442\u0435\u043b\u043e \u2014 \u0436\u0438\u043b\u0438\u0441\u0442\u043e\u0435, \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u043e\u0435 \u043a \u0442\u044f\u0436\u0435\u0441\u0442\u044f\u043c, \u0441 \u043c\u043e\u0437\u043e\u043b\u044f\u043c\u0438 \u043d\u0430 \u043b\u0430\u0434\u043e\u043d\u044f\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d \u043d\u0435 \u043f\u043e\u043c\u043d\u0438\u043b. \u041d\u0430 \u043f\u043e\u044f\u0441\u0435 \u2014 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043c\u0435\u0447 \u0432 \u043f\u043e\u0442\u0451\u0440\u0442\u044b\u0445 \u043d\u043e\u0436\u043d\u0430\u0445.\n\n\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435, \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u043c\u043d\u0438\u043b \u0438\u0437 \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438: \u0437\u0430\u0441\u043d\u0443\u043b \u0434\u043e\u043c\u0430, \u0432 \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0435, \u043d\u0430 \u043e\u0431\u044b\u0447\u043d\u043e\u043c \u0434\u0438\u0432\u0430\u043d\u0435. \u0410 \u0442\u0435\u043f\u0435\u0440\u044c \u2014 \u0437\u0434\u0435\u0441\u044c.\n\n\u041f\u0435\u0440\u0435\u0434 \u0433\u043b\u0430\u0437\u0430\u043c\u0438 \u0432\u0441\u043f\u044b\u0445\u043d\u0443\u043b\u043e \u043e\u043a\u043d\u043e. \u041d\u0435 \u043d\u0430 \u043f\u0430\u0440\u0443\u0441\u0438\u043d\u0435 \u2014 \u0432 \u0441\u0430\u043c\u043e\u043c \u0432\u043e\u0437\u0434\u0443\u0445\u0435, \u043f\u043e\u043b\u0443\u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u043e\u0435, \u0441 \u0440\u043e\u0432\u043d\u044b\u043c\u0438 \u0441\u0442\u0440\u043e\u0447\u043a\u0430\u043c\u0438. \u0415\u0433\u043e \u043d\u0435 \u0432\u0438\u0434\u0435\u043b \u043d\u0438\u043a\u0442\u043e, \u043a\u0440\u043e\u043c\u0435 \u043d\u0435\u0433\u043e.\n\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n\u041a\u041e\u041d\u0422\u0420\u041e\u041b\u042c\u041d\u0410\u042f \u0422\u041e\u0427\u041a\u0410 \u0421\u041e\u0417\u0414\u0410\u041d\u0410\n\u0422\u0415\u041b\u041e: \u041d\u041e\u0422\u0422\u0410, \u041d\u0410\u0401\u041c\u041d\u0418\u041a\n\u0420\u041e\u0422\u0410: \u00ab\u0421\u0415\u0420\u042b\u0415 \u041a\u041e\u041f\u042c\u042f\u00bb\n\u041b\u041e\u041a\u0410\u0426\u0418\u042f: \u041b\u0410\u0413\u0415\u0420\u042c \u0423 \u041a\u0420\u0415\u041f\u041e\u0421\u0422\u0418 \u0422\u041e\u0420\u041d\u0412\u0423\u0414\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n\n\u0421\u043d\u0430\u0440\u0443\u0436\u0438 \u0437\u0432\u044f\u043a\u043d\u0443\u043b\u043e \u0432\u0435\u0434\u0440\u043e, \u043a\u0442\u043e-\u0442\u043e \u0432\u044b\u043c\u0430\u0442\u0435\u0440\u0438\u043b\u0441\u044f \u0441\u043a\u0432\u043e\u0437\u044c \u0437\u0443\u0431\u044b. \u0417\u0430\u043f\u0430\u0445 \u0432\u0430\u0440\u0451\u043d\u043e\u0439 \u043a\u0440\u0443\u043f\u044b \u043f\u043e\u043f\u043e\u043b\u0437 \u0441\u043a\u0432\u043e\u0437\u044c \u0449\u0435\u043b\u044c \u2014 \u043a\u0430\u0448\u0430 \u043d\u0430 \u0443\u0442\u0440\u0435\u043d\u043d\u0435\u043c \u043a\u043e\u0441\u0442\u0440\u0435. \u041e\u0431\u044b\u0447\u043d\u043e\u0435 \u0443\u0442\u0440\u043e \u043d\u0430\u0451\u043c\u043d\u0438\u043a\u0430, \u043a\u0430\u043a\u0438\u0445 \u0431\u0443\u0434\u0435\u0442 \u0435\u0449\u0451 \u0441\u043e\u0442\u043d\u044f. \u0415\u0441\u043b\u0438, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043e\u043d \u043d\u0435 \u0443\u043c\u0440\u0451\u0442 \u0441\u0435\u0433\u043e\u0434\u043d\u044f.", "meta": "{\"sceneTag\":\"opening\"}", "createdAt": "2026-07-31T01:10:18.387Z"}, {"id": "cms88wxlg0003tvd8sl1kn03a", "role": "gm", "content": "\u0422\u044b \u2014 \u041d\u043e\u0442\u0442\u0430. \u0411\u044b\u043b \u043e\u0431\u044b\u0447\u043d\u044b\u043c \u043f\u0430\u0440\u043d\u0435\u043c \u0438\u0437 \u043d\u0430\u0448\u0435\u0433\u043e \u043c\u0438\u0440\u0430, \u0430 \u0442\u0435\u043f\u0435\u0440\u044c \u043e\u0447\u043d\u0443\u043b\u0441\u044f \u0432 \u0442\u0435\u043b\u0435 \u043d\u0430\u0451\u043c\u043d\u0438\u043a\u0430 \u0432 \u0447\u0443\u0436\u043e\u043c \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u0442\u0432\u0435. \u0422\u0435\u043b\u043e \u043f\u043e\u043c\u043d\u0438\u0442, \u043a\u0430\u043a \u0434\u0435\u0440\u0436\u0430\u0442\u044c \u043c\u0435\u0447, \u043d\u043e \u0442\u044b \u2014 \u043d\u0435\u0442. \u041f\u0435\u0440\u0435\u0434 \u0442\u043e\u0431\u043e\u0439 \u043e\u043a\u043d\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u0438\u0434\u0438\u0448\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u044b. \u041f\u0435\u0442\u043b\u044f \u0432\u0440\u0435\u043c\u0435\u043d\u0438: \u0443\u043c\u0440\u0451\u0448\u044c \u2014 \u0432\u0435\u0440\u043d\u0451\u0448\u044c\u0441\u044f \u0441\u044e\u0434\u0430 \u0436\u0435, \u043d\u0430 \u044d\u0442\u043e \u0436\u0435 \u0440\u0430\u0441\u0441\u0432\u0435\u0442, \u043d\u043e \u0441 \u043f\u0430\u043c\u044f\u0442\u044c\u044e \u0438 \u043e\u043f\u044b\u0442\u043e\u043c. \u041f\u0435\u0440\u0432\u0430\u044f \u043f\u0435\u0442\u043b\u044f \u2014 \u0441\u0430\u043c\u0430\u044f \u0442\u0443\u043f\u0430\u044f: \u0442\u044b \u043d\u0438\u043a\u043e\u0433\u043e \u043d\u0435 \u0437\u043d\u0430\u0435\u0448\u044c, \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0443\u043c\u0435\u0435\u0448\u044c, \u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u2014 \u0432\u043e\u0439\u043d\u0430. \u041e\u0441\u043c\u043e\u0442\u0440\u0438\u0441\u044c. \u041f\u043e\u0433\u043e\u0432\u043e\u0440\u0438 \u0441 \u0434\u0435\u0441\u044f\u0442\u043d\u0438\u043a\u043e\u043c. \u0418\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0435\u0448\u044c \u043a\u0430\u0448\u0438 \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438, \u043a\u0430\u043a \u0443\u0441\u0442\u0440\u043e\u0435\u043d \u0434\u0435\u043d\u044c. \u0427\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0448\u044c?", "meta": null, "createdAt": "2026-07-31T01:10:18.389Z"}]
